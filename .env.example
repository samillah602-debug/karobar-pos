# Add a PostgreSQL connection URL from your database provider.
# Use its pooled URL and require TLS for hosted databases.
DATABASE_URL=

# Run pnpm auth:generate to write strong values to .env.local.
# Copy them privately into Vercel environment settings. Never commit them.
POS_ACCESS_PASSWORD=
POS_SESSION_SECRET=

# Optional: seed the new database with clearly labelled sample records.
# Leave false for an empty live store. Existing Sites data is not copied automatically.
POS_DEMO_DATA=false
